<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FountainHome" parent="Theme.MaterialComponents.DayNight.NoActionBar.Bridge">
        <item name="fhBg">@color/bg</item>
        <item name="fhBgClear">@color/bg_clear</item>
        <item name="fhSurface">@color/surface</item>
        <item name="fhSurfaceAlt">@color/surface_alt</item>
        <item name="fhText">@color/text</item>
        <item name="fhTextDim">@color/text_dim</item>
        <item name="fhTextFaint">@color/text_faint</item>
        <item name="fhDivider">@color/divider</item>
        <item name="fhAccent">@color/accent_purple</item>
        <item name="fhAccentSoft">@color/accent_purple_soft</item>
        <item name="fhOnAccent">@color/accent_on</item>
        <item name="fhDanger">@color/danger</item>
        <item name="fhSuccess">@color/success</item>
        <item name="fhInfo">@color/info</item>
        <item name="fhWarning">@color/warning</item>

        <item name="colorPrimary">?attr/fhAccent</item>
        <item name="colorPrimaryVariant">?attr/fhAccent</item>
        <item name="colorOnPrimary">?attr/fhOnAccent</item>
        <item name="colorSecondary">?attr/fhAccent</item>
        <item name="colorSecondaryVariant">?attr/fhAccent</item>
        <item name="colorOnSecondary">?attr/fhOnAccent</item>
        <item name="colorError">?attr/fhDanger</item>
        <item name="colorSurface">?attr/fhSurface</item>
        <item name="colorOnSurface">?attr/fhText</item>
        <item name="android:colorBackground">?attr/fhBg</item>
        <item name="colorOnBackground">?attr/fhText</item>
        <item name="android:textColorPrimary">?attr/fhText</item>
        <item name="android:textColorSecondary">?attr/fhTextDim</item>
        <item name="android:windowBackground">?attr/fhBg</item>
        <item name="android:statusBarColor">?attr/fhBg</item>
        <item name="android:navigationBarColor">?attr/fhSurface</item>
    </style>
    <!-- Launch theme: dark window with the logo centred. Switched to the normal theme in MainActivity. -->
    <style name="Theme.FountainHome.Splash" parent="Theme.FountainHome">
        <item name="android:windowBackground">@drawable/splash_window</item>
    </style>
    <style name="ThemeOverlay.Amoled" parent="">
        <item name="fhBg">@color/amoled_bg</item>
        <item name="fhBgClear">@color/amoled_bg_clear</item>
        <item name="fhSurface">@color/amoled_surface</item>
        <item name="fhSurfaceAlt">@color/amoled_alt</item>
    </style>
    <style name="ThemeOverlay.Accent.Purple" parent="">
        <item name="fhAccent">@color/accent_purple</item>
        <item name="fhAccentSoft">@color/accent_purple_soft</item>
