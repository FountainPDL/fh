<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="?attr/fhSurface">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="60dp" android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="8dp" android:paddingBottom="8dp"
        android:background="?attr/selectableItemBackground" android:id="@+id/row">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:layout_marginEnd="12dp">
            <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="?attr/fhText" android:textSize="15sp"/>
            <TextView android:id="@+id/summary" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="?attr/fhTextDim" android:textSize="12sp" android:layout_marginTop="2dp"/>
        </LinearLayout>
        <TextView android:id="@+id/value" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="?attr/fhAccent" android:textSize="14sp" android:textStyle="bold"/>
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="0.5dp"
        android:background="?attr/fhDivider" android:layout_marginStart="16dp"/>
</LinearLayout>
