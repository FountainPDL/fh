<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:visibility="gone">
    <TextView android:id="@+id/row_title"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="14dp" android:paddingTop="18dp" android:paddingBottom="8dp"
        android:textColor="?attr/fhText" android:textSize="17sp" android:textStyle="bold"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/row_rv"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:clipToPadding="false"
        android:paddingStart="10dp" android:paddingEnd="10dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        xmlns:app="http://schemas.android.com/apk/res-auto"/>
</LinearLayout>
