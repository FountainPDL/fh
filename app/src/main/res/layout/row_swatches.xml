<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="?attr/fhSurface">
    <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="?attr/fhText" android:textSize="15sp"
        android:paddingStart="16dp" android:paddingTop="14dp"/>
    <TextView android:id="@+id/summary" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="?attr/fhTextDim" android:textSize="12sp" android:paddingStart="16dp" android:paddingTop="2dp"/>
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:scrollbars="none" android:overScrollMode="never">
        <LinearLayout android:id="@+id/swatches" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:padding="12dp"/>
    </HorizontalScrollView>
    <View android:layout_width="match_parent" android:layout_height="0.5dp"
        android:background="?attr/fhDivider" android:layout_marginStart="16dp"/>
</LinearLayout>
