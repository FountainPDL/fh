<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?attr/fhBg">

    <androidx.core.widget.NestedScrollView android:id="@+id/home_scroll"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:overScrollMode="never" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingBottom="24dp">

            <!-- Hero -->
            <FrameLayout android:layout_width="match_parent" android:layout_height="520dp">
                <androidx.viewpager2.widget.ViewPager2 android:id="@+id/hero_pager"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:background="?attr/fhSurfaceAlt"/>
                <View android:layout_width="match_parent" android:layout_height="match_parent"
                    android:background="@drawable/gradient_hero"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_gravity="bottom" android:orientation="vertical"
                    android:gravity="center_horizontal" android:padding="16dp">
                    <TextView android:id="@+id/hero_title"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:gravity="center" android:textColor="@color/on_image" android:textSize="30sp"
                        android:textStyle="bold" android:maxLines="2" android:ellipsize="end"
                        android:shadowColor="@color/scrim_full" android:shadowRadius="8"/>
                    <TextView android:id="@+id/hero_meta"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" android:textColor="@color/on_image" android:textSize="13sp"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="16dp" android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <LinearLayout android:id="@+id/hero_mylist"
                            android:layout_width="64dp" android:layout_height="wrap_content"
                            android:orientation="vertical" android:gravity="center_horizontal"
                            android:padding="4dp" android:clickable="true" android:focusable="true">
                            <ImageView android:id="@+id/hero_mylist_icon"
                                android:layout_width="26dp" android:layout_height="26dp"
                                android:src="@drawable/ic_plus" android:tint="@color/on_image"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="My List" android:textColor="@color/on_image" android:textSize="11sp"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>
                        <LinearLayout android:id="@+id/hero_play"
                            android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp"
                            android:layout_marginStart="8dp" android:layout_marginEnd="8dp"
                            android:background="@color/on_image" android:gravity="center"
                            android:clickable="true" android:focusable="true">
                            <ImageView android:layout_width="22dp" android:layout_height="22dp"
                                android:src="@drawable/ic_play" android:tint="@color/on_image_inverse"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Play" android:textColor="@color/on_image_inverse" android:textSize="16sp"
                                android:textStyle="bold" android:layout_marginStart="6dp"/>
                        </LinearLayout>
                        <LinearLayout android:id="@+id/hero_info"
                            android:layout_width="64dp" android:layout_height="wrap_content"
                            android:orientation="vertical" android:gravity="center_horizontal"
                            android:padding="4dp" android:clickable="true" android:focusable="true">
                            <ImageView android:layout_width="26dp" android:layout_height="26dp"
                                android:src="@drawable/ic_info" android:tint="@color/on_image"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Info" android:textColor="@color/on_image" android:textSize="11sp"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/hero_dots"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" android:orientation="horizontal"
                        android:gravity="center"/>
                </LinearLayout>
            </FrameLayout>

            <!-- Offline shortcut -->
            <TextView android:id="@+id/offline_banner"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_margin="12dp" android:padding="12dp" android:visibility="gone"
                android:background="?attr/fhSurface" android:textColor="?attr/fhText" android:textSize="13sp"
                android:text="Can't reach the internet. Tap to open your downloads and saved pages."/>

            <LinearLayout android:id="@+id/rows_container"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Floating top bar -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_gravity="top"
        android:background="@drawable/gradient_top">
        <LinearLayout android:layout_width="match_parent" android:layout_height="52dp"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingStart="16dp" android:paddingEnd="8dp">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="FOUNTAIN" android:textColor="?attr/fhAccent" android:textSize="24sp"
                android:textStyle="bold" android:letterSpacing="0.08"/>
            <ImageButton android:id="@+id/search_btn"
                android:layout_width="44dp" android:layout_height="44dp"
                android:src="@drawable/ic_search" android:tint="@color/on_image" android:padding="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Search"/>
        </LinearLayout>
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:scrollbars="none" android:overScrollMode="never">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="12dp"
                android:paddingBottom="8dp">
                <TextView android:id="@+id/pill_tv" style="@style/HomePill" android:text="TV Shows"/>
                <TextView android:id="@+id/pill_movies" style="@style/HomePill" android:text="Movies"/>
                <TextView android:id="@+id/pill_anime" style="@style/HomePill" android:text="Anime"/>
                <TextView android:id="@+id/pill_offline" style="@style/HomePill" android:text="Offline"/>
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>
</FrameLayout>
